# ── KOPIS 오픈API ────────────────────────────────────────
# 발급: https://www.kopis.or.kr/por/cs/openapi/openApiUseSend.do  (PC에서만, 1인 1키)
# 출처 명시 의무: 출처: (재)예술경영지원센터 공연예술통합전산망(www.kopis.or.kr)
KOPIS_API_KEY=

# ── AI 추출 ──────────────────────────────────────────────
# API 키를 쓰지 않는다. 이미 로그인된 Claude Code CLI를 `claude -p`로 실행한다.
# 확인: claude --version
# PATH에 없거나 다른 실행 파일을 쓰려면 아래로 경로를 지정한다.
# CLAUDE_BIN=claude

# 모델 별칭 (opus | sonnet | haiku). 비우면 opus.
# CLAUDE_MODEL=opus

# ── 실측/디버깅 ──────────────────────────────────────────
# 1이면 Playwright를 headless=false로 띄운다. 셀렉터 조사할 때 사용.
# HEADFUL=1
